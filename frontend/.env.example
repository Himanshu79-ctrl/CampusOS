# CampusOS Frontend Environment Configuration
# Separate configurable API base URLs for backend microservices

# LMS Service (Django - Academics, Content, Attendance, Grades, Reports, Notifications)
VITE_LMS_API_URL=http://127.0.0.1:8000

# Auth Service (Django - Authentication, JWT issuance, User Identity)
VITE_AUTH_API_URL=http://127.0.0.1:8001

# Admin Service (Node.js/Express - Departments, Courses, Faculty Master)
VITE_ADMIN_API_URL=http://127.0.0.1:5000
