# ===================================================================
# CampusOS Authentication Service (Django) - Environment Variables
# ===================================================================

# -------------------------------------------------------------------
# Django Core Settings
# -------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-production-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,campusos-auth.onrender.com

# -------------------------------------------------------------------
# Database Configuration (PostgreSQL on Render / SQLite local fallback)
# -------------------------------------------------------------------
# Option A: Render Managed PostgreSQL (DATABASE_URL takes precedence)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: Individual connection parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=campusos_auth
DB_USER=campusos_user
DB_PASSWORD=replace-with-db-password
DB_HOST=dpg-xxxxxx-a.oregon-postgres.render.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

# -------------------------------------------------------------------
# JWT Authentication Settings
# Shared with LMS Service for mutual token verification
# -------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-shared-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# -------------------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://campusos.onrender.com,https://campusos.yourdomain.edu
# Set to True only for debugging/testing
CORS_ALLOW_ALL_ORIGINS=False

# -------------------------------------------------------------------
# Server Port (Render provides $PORT automatically)
# -------------------------------------------------------------------
PORT=8001
