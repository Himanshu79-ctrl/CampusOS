# CampusOS Authentication Service (Django) - Environment Variables
SECRET_KEY=replace-with-a-secure-production-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.edu

# Database (Default uses SQLite for Auth Service, or configure PostgreSQL)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://campusos.yourdomain.edu
